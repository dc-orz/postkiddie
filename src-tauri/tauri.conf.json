{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PostKiddie",
  "version": "0.1.0",
  "identifier": "dev.postkiddie.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PostKiddie",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true,

        "visible": false,

        "titleBarStyle": "Overlay",
        "hiddenTitle": true,

        "theme": null
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' asset: http://asset.localhost data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "基于 Git 的轻量 HTTP 客户端",
    "longDescription": "PostKiddie 把 HTTP 请求以纯文本形式存放在本地 Git 仓库中，用分支、diff 和 push/pull 完成版本管理与团队共享。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 PostKiddie contributors",
    "licenseFile": "../LICENSE",
    "macOS": {
      "minimumSystemVersion": "14.5"
    },
    "linux": {
      "deb": {
        "depends": ["git"]
      }
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "createUpdaterArtifacts": false
  }
}
